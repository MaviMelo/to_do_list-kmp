-- Tarefas
CREATE TABLE Task (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    completed INTEGER NOT NULL DEFAULT 0,
    dueDateTime INTEGER,              -- epoch millis; NULL = sem vencimento
    createdAt INTEGER NOT NULL,
    categoryId INTEGER,               -- NULL = sem categoria
    FOREIGN KEY (categoryId) REFERENCES Category(id) ON DELETE SET NULL
);

-- Categorias
CREATE TABLE Category (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    color TEXT NOT NULL DEFAULT '#FF5722'
);

-- Dados iniciais de categorias
INSERT INTO Category (name, color) VALUES ('Pessoal', '#2196F3');
INSERT INTO Category (name, color) VALUES ('Trabalho', '#4CAF50');
INSERT INTO Category (name, color) VALUES ('Estudos', '#FF9800');

-- Queries: tarefas
selectAllTasks:
SELECT * FROM Task ORDER BY completed ASC, CASE WHEN dueDateTime IS NULL THEN 1 ELSE 0 END, dueDateTime ASC, createdAt DESC;

selectTaskById:
SELECT * FROM Task WHERE id = :id;

insertTask:
INSERT INTO Task (title, description, completed, dueDateTime, createdAt, categoryId)
VALUES (:title, :description, :completed, :dueDateTime, :createdAt, :categoryId);

updateTask:
UPDATE Task SET title = :title, description = :description, completed = :completed,
    dueDateTime = :dueDateTime, categoryId = :categoryId WHERE id = :id;

setTaskCompleted:
UPDATE Task SET completed = :completed WHERE id = :id;

deleteTask:
DELETE FROM Task WHERE id = :id;

-- Queries: categorias
selectAllCategories:
SELECT * FROM Category ORDER BY name ASC;

selectCategoryById:
SELECT * FROM Category WHERE id = :id;

insertCategory:
INSERT INTO Category (name, color) VALUES (:name, :color);

updateCategory:
UPDATE Category SET name = :name, color = :color WHERE id = :id;

deleteCategory:
DELETE FROM Category WHERE id = :id;

-- Contagem de tarefas por categoria (para exibir no gerenciador)
countTasksInCategory:
SELECT COUNT(*) FROM Task WHERE categoryId = :categoryId;
